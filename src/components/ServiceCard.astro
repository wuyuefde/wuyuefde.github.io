---
import { site } from '../data/site';

interface Props {
  service: (typeof site.services)[number];
  detailed?: boolean;
}

const { service, detailed = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<article class="card">
  {!detailed && (
    <>
      <span class="tag">{service.en}</span>
      <h3 style="margin-top: 12px">{service.name}</h3>
      <p class="muted">{service.who}</p>
    </>
  )}
  <dl class="spec-grid">
    <dt>交付物</dt>
    <dd>{service.delivery}</dd>
    <dt>周期</dt>
    <dd>{service.duration}</dd>
    <dt>验收</dt>
    <dd>{service.success}</dd>
    <dt>边界</dt>
    <dd>{service.leave}</dd>
  </dl>
  {!detailed ? (
    <div class="tag-row"><span class="tag ghost">范围确认后报价</span><span class="tag ghost">验收标准先行</span></div>
  ) : (
    <div class="btn-row service-actions">
      <a class="btn btn-solid" href={base + 'book/'}>{service.cta}</a>
      {service.proof && <a class="proof-link" href={base + service.href}>{service.proof} →</a>}
    </div>
  )}
</article>

<style>
  .service-actions {
    align-items: center;
    margin-top: 20px;
  }

  .service-actions .btn {
    padding: 9px 16px;
    font-size: 13px;
  }

  .proof-link {
    color: var(--hot);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    border-bottom: 1.5px solid rgba(198, 79, 42, 0.35);
    padding-bottom: 1px;
  }

  .proof-link:hover {
    border-bottom-color: var(--hot);
  }
</style>
