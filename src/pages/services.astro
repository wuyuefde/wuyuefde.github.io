---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<Base title="服务" description="业务诊断与一条工作流的 FDE：交付、周期、成功标准与离场时间。">
  <section class="section" style="padding-top: clamp(48px,6vw,72px)">
    <div class="wrap">
      <p class="eyebrow">Services</p>
      <h1 style="margin: 14px 0 16px; font-size: clamp(30px,4.4vw,50px)">两个动作，边界写在明面上。</h1>
      <p class="lede">不打包、不组合售卖。你只需要买你缺的那一步。</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {site.services.map((s, i) => (
        <div style="margin-bottom: 36px">
          <div class="sec-head">
            <div class="idx">{String(i + 1).padStart(2, '0')}</div>
            <div>
              <h2>{s.name}</h2>
              <p>{s.who}</p>
            </div>
          </div>
          <div style="margin-left: 44px; max-width: 760px">
            <ServiceCard service={s} compact />
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead idx="03" title="这些情况我不接" sub="提前说，比签完合同再说省事。" />
      <div class="grid-3">
        <div class="card"><h4>没有自己的业务</h4><p>先去做一件事，再谈用 AI 放大它。</p></div>
        <div class="card"><h4>只想买工具</h4><p>采购清单解决不了「没人会用」这件事。</p></div>
        <div class="card"><h4>要长期驻场</h4><p>我不驻场。要么接受这个方法，要么找别人。</p></div>
      </div>
      <div class="btn-row">
        <a class="btn btn-solid" href={base + 'book/'}>预约一次诊断</a>
        <a class="btn" href={base + 'method/'}>看我的方法</a>
      </div>
    </div>
  </section>
</Base>
