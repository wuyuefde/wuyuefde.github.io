---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;

const faqs = [
  {
    q: '可以只采购诊断或培训吗？',
    a: '可以。诊断不绑定后续培训或 FDE；培训也可以独立采购，但会前需要确认真实岗位任务，会后按约定评审现场产出。',
  },
  {
    q: '没有内部 IT 团队，可以合作吗？',
    a: '可以先从知识整理和低系统耦合的岗位工作流开始。涉及生产系统接入时，需要另行明确权限、接口和所需的技术支持。',
  },
  {
    q: '业务数据如何保护？',
    a: '初筛不需要提交敏感材料。正式项目开始前，会确认保密、脱敏、访问权限和交付后的数据处理边界，再提供相应样例。',
  },
  {
    q: '项目结束后，谁负责维护？',
    a: 'FDE 交付包含操作文档和交接培训，让团队知道如何正常使用和处理异常。修正期、陪跑与长期运维责任按书面方案执行。',
  },
];
---

<Base title="服务方案" description="AI 落地诊断、企业培训与单场景 FDE 交付：典型场景、交付物、周期、验收、客户投入、支持方式与合作边界。">
  <section class="section page-head" style="padding-top: clamp(48px,6vw,72px)">
    <div class="wrap">
      <p class="eyebrow">Services</p>
      <h1 style="margin: 14px 0 16px; font-size: clamp(30px,4.4vw,50px)">你买的不是工具，<br />是能验收、能交接的交付成果。</h1>
      <p class="lede">诊断明确先做什么，培训让团队真正会用，FDE 把一条业务流程跑通。三种服务可独立采购，也可以逐步推进，每一步都有明确产出与验收。</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="selector-intro">
        <p class="eyebrow">Quick Select</p>
        <h2 style="margin: 12px 0 8px">30 秒判断，先从哪项服务开始</h2>
        <p>按你当前最真实的处境选择，不必一开始就采购完整项目。</p>
      </div>
      <div class="table-wrap selector-table">
        <table>
          <thead>
            <tr><th>你现在的情况</th><th>建议入口</th><th>先拿到什么</th></tr>
          </thead>
          <tbody>
            <tr><td>场景很多，不知道先做什么</td><td>AI 落地诊断</td><td>场景优先级、业务基线和落地路线图</td></tr>
            <tr><td>工具已有，团队用不好</td><td>企业培训与工作坊</td><td>岗位工作流和团队统一的操作方法</td></tr>
            <tr><td>场景明确，需要跑通并交接</td><td>单场景 FDE 交付</td><td>可验收的工作流与交接体系</td></tr>
          </tbody>
        </table>
      </div>

      <div class="service-list">
        {site.services.map((s, i) => (
          <div class="service-item">
            <div class="sec-head">
              <div class="idx">{String(i + 1).padStart(2, '0')}</div>
              <div>
                <h2>{s.name}</h2>
                <p>{s.who}</p>
              </div>
            </div>
            <div class="service-detail-wrap">
              <ServiceCard service={s} detailed />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead idx="04" title="为了让项目顺利推进，我们会共同确认三项准备" sub="不要求你一开始就有完整方案。真实问题、明确负责人和共同验收的意愿，比一份看起来很完整的需求文档更重要。" />
      <div class="grid-3">
        <div class="card"><h4>有一条真实业务</h4><p>能说明现在谁在做、怎么做、哪里最耗时，以及出错会造成什么影响。</p></div>
        <div class="card"><h4>有一位业务负责人</h4><p>能协调访谈、样例和测试人员，也能对流程规则与验收结果作判断。</p></div>
        <div class="card"><h4>愿意先小范围验证</h4><p>先用真实问题集跑通一个场景，再决定扩展，不把一次演示当成生产结果。</p></div>
      </div>
      <div class="callout pricing-note">
        <strong style="color: var(--ink)">报价依据：</strong>根据访谈与流程范围、参训岗位、系统接入、数据权限和运维责任核算。初筛后书面确认交付范围、双方投入、里程碑和验收方式，不用模糊人天不断扩大项目。
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead idx="05" title="采购前，通常还会确认这些问题" sub="把数据安全、系统条件和项目结束后的责任提前讲清，减少合作中的不确定性。" />
      <div class="faq-list">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <div class="btn-row">
        <a class="btn btn-solid" href={base + 'book/'}>预约需求初筛</a>
        <a class="btn" href={base + 'demo/'}>先看三个行业方案</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .selector-intro {
    margin-bottom: 24px;
  }

  .selector-table td:first-child {
    color: var(--ink);
    font-weight: 700;
  }

  .selector-table td:nth-child(2) {
    color: var(--hot);
    font-weight: 800;
    white-space: nowrap;
  }

  .service-list {
    margin-top: 58px;
  }

  .service-item + .service-item {
    margin-top: 58px;
  }

  .service-detail-wrap {
    margin-left: 44px;
    max-width: 820px;
  }

  .pricing-note {
    margin-top: 20px;
  }

  .faq-list {
    display: grid;
    gap: 12px;
    max-width: 820px;
  }

  .faq-list details {
    background: var(--panel);
    border: 2px solid var(--ink);
    border-radius: 12px;
    box-shadow: var(--shadow);
  }

  .faq-list summary {
    position: relative;
    padding: 15px 48px 15px 18px;
    color: var(--ink);
    font-size: 14.5px;
    font-weight: 800;
    line-height: 1.6;
    cursor: pointer;
    list-style: none;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-list summary::after {
    content: '+';
    position: absolute;
    right: 18px;
    top: 12px;
    color: var(--hot);
    font-size: 22px;
    font-weight: 700;
  }

  .faq-list details[open] summary::after {
    content: '−';
  }

  .faq-list details p {
    padding: 0 18px 17px;
    font-size: 14px;
  }

  @media (max-width: 860px) {
    .service-detail-wrap {
      margin-left: 0;
    }
  }
</style>
