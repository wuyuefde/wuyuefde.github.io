---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
const formUrl = site.formUrl;

const steps = [
  { n: '1', t: '20 分钟初筛', d: '了解你的业务、当前卡点和期望结果，判断问题是否适合用 AI 解决。' },
  { n: '2', t: '给出适配建议', d: '说明建议从诊断、培训还是单场景 FDE 开始；如果暂时不该做，也会直接说明。' },
  { n: '3', t: '确认正式方案', d: '适合继续时，再确认交付范围、双方投入、时间、费用和验收方式。' },
];
---

<Base title="预约需求初筛" description="用 20 分钟说清业务场景、当前卡点与目标，判断适合从诊断、培训还是 FDE 交付开始。">
  <section class="section page-head" style="padding-top: clamp(48px,6vw,72px)">
    <div class="wrap">
      <p class="eyebrow">Book</p>
      <h1 style="margin: 14px 0 16px; font-size: clamp(30px,4.4vw,50px)">先聊一条真实业务，<br />不急着谈大方案。</h1>
      <p class="lede">你不需要先准备完整需求文档。只要说清现在怎么做、哪里最耗时，以及什么错误不能发生，就足够开始。</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-3" style="margin-bottom: 44px">
        {steps.map((s) => (
          <article class="card">
            <span class="tag">{s.n}</span>
            <h4 style="margin-top: 10px">{s.t}</h4>
            <p>{s.d}</p>
          </article>
        ))}
      </div>

      <div class="grid-2" style="align-items: start">
        <article class="card form-entry">
          <h4>填写预约表</h4>
          <p style="margin-top: 8px">大约 2 分钟。写上称呼、角色、你们在做什么，以及最想解决的问题。</p>
          <a class="btn btn-solid form-btn" href={formUrl} target="_blank" rel="noopener noreferrer">打开预约表单</a>
          <p class="hint" style="margin-top: 14px">表单在飞书页面打开，提交后我当天就能看到，1 个工作日内回复。你填写的信息仅用于本次需求沟通。</p>
        </article>

        <div>
          <div class="card">
            <h4>直接联系</h4>
            <p style="margin-top: 8px">微信：<span style="color: var(--ink); font-weight: 700">{site.wechat}</span></p>
            <p>邮箱：<a href={`mailto:${site.email}`} style="color: var(--hot); font-weight: 600">{site.email}</a></p>
            {site.wechatQr && <img src={base + site.wechatQr.replace(/^\//, '')} alt="微信二维码" width="150" style="margin-top: 14px; border: 2px solid var(--ink); border-radius: 12px; background: #fff" />}
          </div>
          <div class="callout" style="margin-top: 16px">
            <strong style="color: var(--ink)">初筛不需要敏感材料。</strong>请不要在表单里上传客户名单、账号密码、密钥或未脱敏业务数据。
          </div>
          <div class="card" style="margin-top: 16px">
            <h4>初筛之后</h4>
            <p style="margin-top: 6px">如果适合继续，我会说明建议的合作方式、交付范围和费用；如果暂时不适合，也会给出原因与可行的前置动作。</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .form-btn {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 18px;
  }
</style>
