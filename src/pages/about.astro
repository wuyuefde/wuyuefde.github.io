---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;

const timeline = [
  { year: '早期职业阶段', t: '风控建模与数据分析', action: '先量基线', d: '在金融服务业务里做风控建模和数据分析：先用指标和样本验证，再讨论方案。留下的动作是——把现状量出来，不凭感觉判断值不值得做。' },
  { year: '随后', t: '贷后运营与策略体系', action: '分清责任', d: '做贷后策略与 M1 运营，把策略、人员、外部供应方和监控指标放在同一条链路上。留下的动作是——先讲清谁负责，哪些判断必须留给人。' },
  { year: '近一年', t: 'AI 外呼与智能路由', action: '跑通再交接', d: '牵头 AI 外呼与线路动态路由落地，把模型放回真实业务流程里验证：标准化环节交给 AI，异常与关键判断留给人。留下的动作是——跑通之后，交给团队自己维护。' },
];
---

<Base title="关于主理人" description="7 年金融业务与策略经验。做法固定为三步：先量业务基线，再设计人工门禁，最后跑通交给团队——这就是我在项目里做 FDE 的方式。">
  <section class="section page-head" style="padding-top: clamp(48px,6vw,72px)">
    <div class="wrap">
      <p class="eyebrow">About</p>
      <h1 style="margin: 14px 0 16px; font-size: clamp(30px,4.4vw,50px)">先把业务跑通，<br />再把 AI 交出去。</h1>
      <p class="lede">我的经历集中在容错很低的地方：金融风控、贷后运营、AI 外呼。那里没有“先上线看看”——每一步要留痕，每个关键判断要留人。这套习惯，现在就是我做 FDE 的方式。</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-2">
        <div class="card" style="background: var(--tint)">
          <div style="display:flex; gap:16px; align-items:center; flex-wrap:wrap">
            {site.avatar ? <img src={base + site.avatar.replace(/^\//, '')} alt={`${site.name} 的照片`} width="88" height="88" style="width:88px;height:88px;border-radius:10px;border:2px solid var(--ink);object-fit:cover" /> : <div style="width:88px;height:88px;border-radius:10px;border:2px solid var(--ink);background:rgba(var(--accent-rgb),.18);display:grid;place-items:center;color:var(--ink);font-weight:800;font-size:12px;letter-spacing:.12em">照片</div>}
            <div>
              <h3>{site.name}</h3>
              <p class="muted">{site.role} · {site.city}</p>
            </div>
          </div>
          <p style="margin-top: 16px">7 年金融业务与策略经验，做过风控、数据分析、贷后运营和 AI 外呼。现在用同一套做法做企业 AI 诊断、培训和 FDE 交付：先量基线，再布门禁，最后跑通交给团队。</p>
          <div class="tag-row">
            <span class="tag">业务出身</span>
            <span class="tag ghost">AI 项目落地</span>
            <span class="tag ghost">验收与风险导向</span>
          </div>
        </div>

        <div class="card">
          <h4>一个负责人，对完整交付负责</h4>
          <p style="margin-top: 8px">固定：{site.team.fixed.join('、')}——这些核心环节始终由我负责。</p>
          <p style="margin-top: 6px">协作：{site.team.flex.map((f) => f.name).join('、')}——按项目引入，角色、费用与交付范围提前说明。</p>
          <div class="callout" style="margin-top: 16px; font-size: 14px">{site.team.promise}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead idx="02" title="三段经历，留下三个动作" sub="行业换了，做法没换。下面这三件事，是我在每个项目里固定要做的。" />
      <div class="grid-3">
        {timeline.map((t) => (
          <article class="card">
            <p class="eyebrow">{t.year}</p>
            <h4 style="margin: 8px 0 6px">{t.t}</h4>
            <span class="tag">{t.action}</span>
            <p style="margin-top: 10px">{t.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead idx="03" title="这套做法，在你的项目里是什么样" sub="诊断、交付、交接三个阶段，动作是固定的；具体内容按你的业务来。" />
      <div class="table-wrap">
        <table>
          <thead><tr><th>固定动作</th><th>在项目里具体做什么</th></tr></thead>
          <tbody>
            <tr><td>先量基线</td><td>诊断期把现状的耗时、错误率、人工占用比例量出来，再决定先做哪一条流程</td></tr>
            <tr><td>设计门禁</td><td>哪些交给 AI、哪些必须转给人、出错了怎么处理，写进方案，而不是嘴上说</td></tr>
            <tr><td>跑通再交接</td><td>文档、培训、验收问题集一起给，团队能自己跑、能自己改</td></tr>
          </tbody>
        </table>
      </div>
      <div class="btn-row">
        <a class="btn btn-solid" href={base + 'book/'}>聊聊你的业务场景</a>
      </div>
    </div>
  </section>
</Base>
