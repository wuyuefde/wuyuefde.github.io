---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;

const timeline = [
  { year: '早期职业阶段', t: '风控建模与数据分析', d: '在金融服务业务中做过风控建模与数据分析，习惯从指标、样本和业务规则出发，而不是从工具功能出发。' },
  { year: '随后', t: '贷后运营与策略体系', d: '做过 M1 运营策略和贷后策略体系，理解策略、人员、供应方与监控指标如何共同影响一条业务链路。' },
  { year: '近一年', t: 'AI 外呼与智能路由', d: '牵头 AI 催收大模型项目落地，并设计外呼线路动态路由机制，把模型能力放回真实业务流程中验证。' },
];
---

<Base title="关于主理人" description="7 年金融业务与策略经验，做过 AI 外呼项目落地；负责业务诊断、方案设计、交付与验收。">
  <section class="section page-head" style="padding-top: clamp(48px,6vw,72px)">
    <div class="wrap">
      <p class="eyebrow">About</p>
      <h1 style="margin: 14px 0 16px; font-size: clamp(30px,4.4vw,50px)">做过业务策略，<br />也下场做 AI 落地。</h1>
      <p class="lede">我更关心一项 AI 投入能不能进入日常流程、能不能被团队使用、能不能通过业务验收，而不是演示时看起来有多先进。</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-2">
        <div class="card" style="background: var(--tint)">
          <div style="display:flex; gap:16px; align-items:center; flex-wrap:wrap">
            {site.avatar ? <img src={base + site.avatar.replace(/^\//, '')} alt={`${site.name} 的照片`} width="88" height="88" style="width:88px;height:88px;border-radius:10px;border:2px solid var(--ink);object-fit:cover" /> : <div style="width:88px;height:88px;border-radius:10px;border:2px solid var(--ink);background:rgba(var(--accent-rgb),.18);display:grid;place-items:center;color:var(--ink);font-weight:800;font-size:12px;letter-spacing:.12em">照片</div>}
            <div>
              <h3>{site.name}</h3>
              <p class="muted">{site.role} · {site.city}</p>
            </div>
          </div>
          <p style="margin-top: 16px">7 年金融业务与策略经验。做过风控、数据分析、贷后运营与 AI 外呼项目，现在把这些经验用于企业 AI 诊断、培训和 FDE 交付。</p>
          <div class="tag-row">
            <span class="tag">业务出身</span>
            <span class="tag ghost">AI 项目落地</span>
            <span class="tag ghost">验收与风险导向</span>
          </div>
        </div>

        <div class="card">
          <h4>一个负责人，对完整交付负责</h4>
          <p style="margin-top: 8px">固定：{site.team.fixed.join('、')}——这些核心环节始终由我负责。</p>
          <p style="margin-top: 6px">协作：{site.team.flex.map((f) => f.name).join('、')}——按项目引入，角色、费用与交付范围提前说明。</p>
          <div class="callout" style="margin-top: 16px; font-size: 14px">{site.team.promise}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead idx="02" title="经历如何变成交付能力" sub="不列无法核对的头衔，只呈现与这次合作直接相关的业务经验。" />
      <div class="grid-3">
        {timeline.map((t) => (
          <article class="card">
            <p class="eyebrow">{t.year}</p>
            <h4 style="margin: 8px 0 6px">{t.t}</h4>
            <p>{t.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead idx="03" title="这些经历，对客户有什么用" sub="技术会更新，业务拆解、风险意识和验收方法可以复用。" />
      <div class="table-wrap">
        <table>
          <thead><tr><th>我带来的能力</th><th>在项目里的具体作用</th></tr></thead>
          <tbody>
            <tr><td>业务拆解</td><td>把“想用 AI 提效”拆成岗位、任务、流程、规则和可衡量指标</td></tr>
            <tr><td>风险意识</td><td>提前设计权限、人工审核、异常处理与失败降级，不让演示直接替代生产验证</td></tr>
            <tr><td>验收思维</td><td>先测基线、再定问题集和验收口径，避免项目结束时双方对“做成了”理解不同</td></tr>
          </tbody>
        </table>
      </div>
      <div class="btn-row">
        <a class="btn btn-solid" href={base + 'book/'}>聊聊你的业务场景</a>
      </div>
    </div>
  </section>
</Base>
