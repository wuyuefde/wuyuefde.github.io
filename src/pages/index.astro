---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<Base title="企业 AI 落地" description={site.lead}>
  <!-- 01 首屏 -->
  <section class="hero">
    <div class="hero-deco" aria-hidden="true">
      <svg viewBox="0 0 260 240">
        <g stroke="#43301C" stroke-width="6" stroke-linejoin="round" stroke-linecap="round">
          <circle cx="100" cy="18" r="9" fill="#4A2C17" stroke="none" />
          <circle cx="126" cy="18" r="9" fill="#F0940A" stroke="none" />
          <circle cx="152" cy="18" r="9" fill="#1D74D0" stroke="none" />
          <polygon points="122,40 138,40 144,62 116,62" fill="#F2E2AE" />
          <polygon points="96,62 164,62 178,92 82,92" fill="#F7EDCB" />
          <polygon points="88,92 172,92 164,150 96,150" fill="#F2E2AE" />
          <rect x="92" y="150" width="76" height="26" rx="8" fill="#F0940A" />
          <polygon points="96,176 164,176 176,224 84,224" fill="#F7EDCB" />
          <path d="M172,102 C204,98 208,138 174,144" fill="none" stroke-width="10" />
          <path d="M88,100 L66,116 L88,124" fill="none" stroke-width="6" />
          <ellipse cx="112" cy="116" rx="12" ry="22" fill="#FBF3D8" stroke="none" opacity=".8" />
        </g>
      </svg>
    </div>
    <div class="wrap hero-inner">
      <p class="eyebrow">{site.role} · {site.city}</p>
      <h1>
        {site.headline.map((line, i) => <span class="line">{line}{i < site.headline.length - 1 && <br />}</span>)}
      </h1>
      <p class="lede">{site.lead}</p>
      <div class="btn-row">
        <a class="btn btn-solid" href={base + 'book/'}>预约需求初筛</a>
        <a class="btn" href={base + 'demo/'}>查看脱敏案例</a>
      </div>
      <p class="hint" style="margin-top: 16px">{site.price} · 不合适会继续，也会直接说明</p>
    </div>
  </section>

  <!-- 02 拆解示范 -->
  <section class="section">
    <div class="wrap">
      <SectionHead
        idx="01"
        title="以客户咨询为例，看一条流程怎样被拆开"
        sub="用最常见、也最容易被低估的场景，演示从“想上 AI 客服”到一条可验收流程的三步拆法。"
      />
      <div class="grid-3">
        <article class="card">
          <span class="tag">表面诉求</span>
          <h4 style="margin-top: 10px">上了一套 AI 客服，问题并没有变少</h4>
          <p>工具接上之后才发现：哪些问题有标准答案没人梳理，客户问法五花八门，转人工没有规则，答错了也没人复核。工具解决的是回答速度，不是回答质量。</p>
        </article>
        <article class="card">
          <span class="tag">真实卡点</span>
          <h4 style="margin-top: 10px">要拆的其实是三层东西</h4>
          <p>知识覆盖：哪些问题有稳定答案；问题分层：哪些必须转给人；口径一致：同一个问题不能有几种说法。这三层不定清楚，模型越强，只是把错误回答得更快。</p>
        </article>
        <article class="card">
          <span class="tag">可复用方法</span>
          <h4 style="margin-top: 10px">换个场景，骨架是一样的</h4>
          <p>知识库、首答、转人工规则、准确率抽检。把客服换成报价、对账或单据审核，拆法不变——这也是我在金融 AI 项目里反复验证过的一点。</p>
        </article>
      </div>
      <div class="callout" style="margin-top: 18px">
        判断标准不是“AI 能不能做”，而是这条流程是否<span class="key">高频、有标准答案、有明确负责人，并且能用一组问题集验收</span>。
      </div>
      <div class="btn-row">
        <a class="btn" href={base + 'demo/'}>看三个脱敏案例</a>
        <a class="btn" href={base + 'book/'}>聊聊你的业务流程</a>
      </div>
    </div>
  </section>

  <!-- 03 脱敏案例 -->
  <section class="section">
    <div class="wrap">
      <SectionHead
        idx="02"
        title="三个行业场景，看方案怎样落到业务里"
        sub="不是罗列 AI 功能，而是把表面诉求、第一期切口、交付物、人工门禁与验收边界讲清楚。以下均为脱敏案例，不代表真实客户成果。"
      />
      <div class="grid-3">
        <article class="card">
          <span class="tag ghost">批发零售 · 知识资产化</span>
          <h3 style="margin: 12px 0 8px">从 2–5 天报价，到当天生成候选清单</h3>
          <p>把找货、替代、配套与出处做成工作流，最终价格与对外发送仍由人确认。</p>
          <p style="margin-top: 14px"><a class="case-link" href={base + 'demo/#wholesale-quote'}>查看酒店用品批发方案 →</a></p>
        </article>
        <article class="card">
          <span class="tag ghost">制造业 · 模糊输入结构化</span>
          <h3 style="margin: 12px 0 8px">从一句“上次那种”，到可确认的规格草稿</h3>
          <p>用历史订单锚定模糊指代，一次性补齐参数，不让 AI 猜测后直接下单。</p>
          <p style="margin-top: 14px"><a class="case-link" href={base + 'demo/#manufacturing-inquiry'}>查看紧固件询价方案 →</a></p>
        </article>
        <article class="card">
          <span class="tag ghost">电商 · 跨系统动作闭环</span>
          <h3 style="margin: 12px 0 8px">让缺货告警直接触发动作，而不止是上大屏幕</h3>
          <p>打通库存对账、异常卡片与投放建议，人工确认后执行并保留追溯记录。</p>
          <p style="margin-top: 14px"><a class="case-link" href={base + 'demo/#ecommerce-action'}>查看多平台电商方案 →</a></p>
        </article>
      </div>
      <div class="callout" style="margin-top: 18px">
        另有工艺经验萃取、三系统对账、包装预检、内容资产化等 <span class="key">7 个可诊断场景</span>，按业务问题与参考交付物简要展示。
        <a class="case-link" href={base + 'demo/#more-scenarios'}>查看完整场景清单 →</a>
      </div>
    </div>
  </section>

  <!-- 04 交付方式 -->
  <section class="section">
    <div class="wrap">
      <SectionHead
        idx="03"
        title="三种合作方式，对应三个落地阶段"
        sub="不知道先做什么，就从诊断开始；团队不会用，就做岗位工作坊；场景已经明确，就进入单场景 FDE 交付。"
      />
      <div class="grid-2">
        {site.services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <!-- 05 合作边界 + 项目责任 -->
  <section class="section">
    <div class="wrap">
      <SectionHead
        idx="04"
        title="合作之前，先把规则讲清楚"
        sub="边界不是少做事，而是让投入、责任和验收在开始前就有共同口径。"
      />
      <div class="grid-3">
        {site.noList.map((n) => (
          <article class="card">
            <h4>{n.title}</h4>
            <p>{n.text}</p>
          </article>
        ))}
      </div>

      <div style="margin-top: 40px">
        <h3>一个项目负责人，按需补齐专业能力</h3>
        <p style="margin-top: 8px; max-width: 680px">
          我负责从业务诊断到验收的完整闭环。项目需要额外能力时，再引入设计、工程、行业或合规角色，避免为一单项目搭一套冗余团队。
        </p>
        <div class="table-wrap" style="margin-top: 18px">
          <table>
            <thead>
              <tr><th>始终由我负责</th><th>按项目引入</th></tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  {site.team.fixed.map((f) => <div>· {f}</div>)}
                </td>
                <td>
                  {site.team.flex.map((f) => <div>· {f.name} <span class="muted">— {f.note}</span></div>)}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="callout" style="margin-top: 16px">{site.team.promise}</div>
      </div>
    </div>
  </section>

  <!-- 06 合作方式 -->
  <section class="section">
    <div class="wrap">
      <SectionHead
        idx="05"
        title="合作方式与报价原则"
        sub="先确认范围，再确认价格。每一笔费用都对应明确交付物、双方投入和验收方式。"
      />
      <div class="grid-2">
        <article class="card">
          <h4>诊断与培训</h4>
          <p style="font-size: 22px; color: var(--ink); font-weight: 700; margin: 10px 0 6px">按范围与交付物报价</p>
          <p>需求初筛后确认访谈、课程和产出范围。开始前写清日程、交付物、客户配合事项与验收方式。</p>
        </article>
        <article class="card">
          <h4>单场景 FDE 交付</h4>
          <p style="font-size: 22px; color: var(--ink); font-weight: 700; margin: 10px 0 6px">按项目与里程碑报价</p>
          <p>先验证一个场景，再决定是否扩展。系统对接、数据权限、人工审核和运维责任在方案中单独列明。</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 07 联系 -->
  <section class="section">
    <div class="wrap">
      <SectionHead
        idx="06"
        title="先聊 20 分钟，判断是否值得继续"
        sub="你可以只带一条真实流程：现在谁在做、哪里最耗时、出了问题谁负责。暂时不适合用 AI，我也会直接说明。"
      />
      <div class="btn-row" style="margin-top: 0">
        <a class="btn btn-solid" href={base + 'book/'}>预约需求初筛</a>
        <a class="btn" href={base + 'services/'}>先查看服务方案</a>
      </div>
      <p class="hint" style="margin-top: 16px">初筛不需要提交敏感业务数据；具体材料在确认合作与保密边界后提供。</p>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(52px, 7vw, 92px) 0 clamp(46px, 5.5vw, 72px);
    border-bottom: 2px solid var(--ink);
  }

  .hero-deco {
    position: absolute;
    right: clamp(16px, 6vw, 96px);
    top: 50%;
    transform: translateY(-50%);
    width: clamp(130px, 15vw, 200px);
    z-index: 1;
    pointer-events: none;
    opacity: 0.95;
  }

  .hero-deco svg {
    width: 100%;
    height: auto;
  }

  .hero-inner {
    position: relative;
    z-index: 3;
    width: 100%;
  }

  .hero .eyebrow {
    margin-bottom: 24px;
  }

  .hero h1 {
    margin: 0 0 22px;
    max-width: 16em;
  }

  @media (max-width: 900px) {
    .hero-deco {
      display: none;
    }
  }

  .line {
    display: inline;
  }

  .case-link {
    color: var(--hot);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    border-bottom: 1.5px solid rgba(198, 79, 42, 0.35);
    padding-bottom: 1px;
  }

  .case-link:hover {
    border-bottom-color: var(--hot);
  }
</style>
