---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<Base title="企业 AI 落地" description={site.lead}>
  <!-- 01 首屏 -->
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="eyebrow">{site.role} · {site.city}</p>
      <h1>
        {site.headline.map((line, i) => <span class="line">{line}{i < site.headline.length - 1 && <br />}</span>)}
      </h1>
      <p class="lede">{site.lead}</p>
      <div class="btn-row">
        <a class="btn btn-solid" href={base + 'book/'}>预约需求初筛</a>
        <a class="btn" href={base + 'demo/'}>查看脱敏案例</a>
      </div>
      <p class="hint" style="margin-top: 16px">{site.price} · 不合适会继续，也会直接说明</p>
    </div>
  </section>

  <!-- 02 三层诊断 -->
  <section class="section">
    <div class="wrap">
      <SectionHead
        idx="01"
        title="同一句「我们想做 AI」，背后是三种不同的问题"
        sub="先判断问题落在哪一层，再决定是补场景、改流程，还是建机制。层判断错了，投入就会花在错误的地方。"
      />
      <div class="grid-3">
        {site.layers.map((l) => (
          <article class="card">
            <p class="eyebrow">{l.n}</p>
            <h3 style="margin: 8px 0 6px">{l.name}</h3>
            <p style="color: var(--ink)">{l.q}</p>
            <p class="muted" style="margin-top: 8px">典型症状：{l.symptom}</p>
          </article>
        ))}
      </div>
      <div class="callout" style="margin-top: 18px">
        <span class="key">诊断错层，钱就花在错的地方。</span>判断清楚属于哪一层，再决定做诊断、培训还是单场景交付，而不是先买一套工具。
      </div>
      <div class="btn-row">
        <a class="btn" href={base + 'method/'}>查看交付方法与验收口径</a>
      </div>
    </div>
  </section>

  <!-- 03 脱敏案例 -->
  <section class="section">
    <div class="wrap">
      <SectionHead
        idx="02"
        title="三个行业场景，看方案怎样落到业务里"
        sub="不是罗列 AI 功能，而是把原来的做法、改成什么样、哪些还得人来决定讲清楚。以下均为脱敏案例，不代表真实客户成果。"
      />
      <div class="grid-3">
        <article class="card">
          <p class="industry">批发零售</p>
          <h3 style="margin: 4px 0 8px">报价从等两三天，变成当天出清单</h3>
          <p>把找货、替代型号和配套件整理成流程，最后的价格和发出去，仍由业务员确认。</p>
          <p style="margin-top: 14px"><a class="case-link" href={base + 'demo/#wholesale-quote'}>查看酒店用品批发方案 →</a></p>
        </article>
        <article class="card">
          <p class="industry">制造业</p>
          <h3 style="margin: 4px 0 8px">客户只说「上次那种」，也能问清规格</h3>
          <p>先翻这个客户的历史订单，一次把缺的参数问全，不让 AI 猜完就直接下单。</p>
          <p style="margin-top: 14px"><a class="case-link" href={base + 'demo/#manufacturing-inquiry'}>查看紧固件询价方案 →</a></p>
        </article>
        <article class="card">
          <p class="industry">电商</p>
          <h3 style="margin: 4px 0 8px">缺货不只报个警，还告诉你该做什么</h3>
          <p>库存一对账就给出处理建议，人工确认后执行，每一步都留痕可查。</p>
          <p style="margin-top: 14px"><a class="case-link" href={base + 'demo/#ecommerce-action'}>查看多平台电商方案 →</a></p>
        </article>
      </div>
      <div class="callout" style="margin-top: 18px">
        另有工艺经验萃取、三系统对账、包装预检、内容资产化等 <span class="key">7 个可诊断场景</span>，按业务问题与参考交付物简要展示。
        <a class="case-link" href={base + 'demo/#more-scenarios'}>查看完整场景清单 →</a>
      </div>
    </div>
  </section>

  <!-- 04 交付方式 -->
  <section class="section">
    <div class="wrap">
      <SectionHead
        idx="03"
        title="三种合作方式，对应三个落地阶段"
        sub="不知道先做什么，就从诊断开始；团队不会用，就做岗位工作坊；场景已经明确，就进入单场景 FDE 交付。"
      />
      <div class="grid-2">
        {site.services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <!-- 05 合作边界 + 项目责任 -->
  <section class="section">
    <div class="wrap">
      <SectionHead
        idx="04"
        title="合作之前，先把规则讲清楚"
        sub="边界不是少做事，而是让投入、责任和验收在开始前就有共同口径。"
      />
      <div class="grid-3">
        {site.noList.map((n) => (
          <article class="card">
            <h4>{n.title}</h4>
            <p>{n.text}</p>
          </article>
        ))}
      </div>

      <div style="margin-top: 40px">
        <h3>一个项目负责人，按需补齐专业能力</h3>
        <p style="margin-top: 8px; max-width: 680px">
          我负责从业务诊断到验收的完整闭环。项目需要额外能力时，再引入设计、工程、行业或合规角色，避免为一单项目搭一套冗余团队。
        </p>
        <div class="table-wrap" style="margin-top: 18px">
          <table>
            <thead>
              <tr><th>始终由我负责</th><th>按项目引入</th></tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  {site.team.fixed.map((f) => <div>· {f}</div>)}
                </td>
                <td>
                  {site.team.flex.map((f) => <div>· {f.name} <span class="muted">— {f.note}</span></div>)}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="callout" style="margin-top: 16px">{site.team.promise}</div>
      </div>
    </div>
  </section>

  <!-- 06 合作方式 -->
  <section class="section">
    <div class="wrap">
      <SectionHead
        idx="05"
        title="合作方式与报价原则"
        sub="先确认范围，再确认价格。每一笔费用都对应明确交付物、双方投入和验收方式。"
      />
      <div class="grid-2">
        <article class="card">
          <h4>诊断与培训</h4>
          <p style="font-size: 22px; color: var(--ink); font-weight: 700; margin: 10px 0 6px">按范围与交付物报价</p>
          <p>需求初筛后确认访谈、课程和产出范围。开始前写清日程、交付物、客户配合事项与验收方式。</p>
        </article>
        <article class="card">
          <h4>单场景 FDE 交付</h4>
          <p style="font-size: 22px; color: var(--ink); font-weight: 700; margin: 10px 0 6px">按项目与里程碑报价</p>
          <p>先验证一个场景，再决定是否扩展。系统对接、数据权限、人工审核和运维责任在方案中单独列明。</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 07 联系 -->
  <section class="section">
    <div class="wrap">
      <SectionHead
        idx="06"
        title="先聊 20 分钟，判断是否值得继续"
        sub="你可以只带一条真实流程：现在谁在做、哪里最耗时、出了问题谁负责。暂时不适合用 AI，我也会直接说明。"
      />
      <div class="btn-row" style="margin-top: 0">
        <a class="btn btn-solid" href={base + 'book/'}>预约需求初筛</a>
        <a class="btn" href={base + 'services/'}>先查看服务方案</a>
      </div>
      <p class="hint" style="margin-top: 16px">初筛不需要提交敏感业务数据；具体材料在确认合作与保密边界后提供。</p>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(52px, 7vw, 92px) 0 clamp(46px, 5.5vw, 72px);
    border-bottom: 2px solid var(--ink);
  }

  .hero-inner {
    position: relative;
    z-index: 3;
    width: 100%;
    animation: heroRise 0.55s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    animation-delay: 60ms;
  }

  .hero-inner > * {
    animation: heroRise 0.55s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }

  .hero-inner > *:nth-child(1) {
    animation-delay: 80ms;
  }

  .hero-inner > *:nth-child(2) {
    animation-delay: 160ms;
  }

  .hero-inner > *:nth-child(3) {
    animation-delay: 240ms;
  }

  .hero-inner > *:nth-child(4) {
    animation-delay: 320ms;
  }

  .hero-inner > *:nth-child(5) {
    animation-delay: 400ms;
  }

  @keyframes heroRise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-inner,
    .hero-inner > * {
      animation: none;
    }
  }

  .hero .eyebrow {
    margin-bottom: 24px;
  }

  .hero h1 {
    margin: 0 0 22px;
    max-width: 16em;
  }

  .line {
    display: inline;
  }

  .industry {
    display: inline-block;
    margin: 0 0 10px;
    padding: 0 4px 2px;
    font-size: 21px;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: 0.02em;
    background: linear-gradient(transparent 62%, rgba(240, 148, 10, 0.42) 62%);
  }

  .case-link {
    color: var(--hot);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    border-bottom: 1.5px solid rgba(198, 79, 42, 0.35);
    padding-bottom: 1px;
  }

  .case-link:hover {
    border-bottom-color: var(--hot);
  }
</style>
