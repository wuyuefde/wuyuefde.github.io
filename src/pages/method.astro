---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;

const principles = [
  { n: '01', t: '业务基线先于技术方案', d: '先记录耗时、质量、成本，再决定改哪里。没有基线，不承诺提升比例。' },
  { n: '02', t: '用智能体、知识库与自动化工作流搭建', d: '智能体执行任务，知识库提供业务规则，自动化让流程稳定运行。' },
  { n: '03', t: 'Human in the Loop', d: 'AI 整理和建议，人负责判断与验收；涉及资金和客户承诺，必须人工把关。' },
  { n: '04', t: '先跑通一个，再复制一批', d: '先用真实问题验证一个场景，确认成立，再扩展到更多流程。' },
];

const steps = [
  { n: '1', t: '诊断', d: '看业务、流程与数据基础' },
  { n: '2', t: '方案', d: '定范围、分工与验收口径' },
  { n: '3', t: '验证', d: '小范围跑通并修正问题' },
  { n: '4', t: '验收', d: '交付文档、培训与结果' },
];
---

<Base title="交付方法" description="从业务场景、工作流程到组织机制，用智能体、知识库与自动化工作流，加上人工门禁和验收基线，完成企业 AI 落地。">
  <section class="section page-head" style="padding-top: clamp(48px,6vw,72px)">
    <div class="wrap">
      <p class="eyebrow">Method</p>
      <h1 style="margin: 14px 0 16px; font-size: clamp(30px,4.4vw,50px)">先找到真正的问题，<br />再决定 AI 做什么。</h1>
      <p class="lede">“想做 AI”背后，可能是场景没选对、流程跑不稳，或团队接不住。诊断错层，钱就花错地方。</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead idx="01" title="三层诊断" sub="先判断问题在哪一层，再匹配诊断、培训或交付。" />
      <div class="grid-3">
        {site.layers.map((l) => (
          <article class="card">
            <p class="eyebrow">{l.n}</p>
            <h3 style="margin: 8px 0 6px">{l.name}</h3>
            <p style="color: var(--ink)">{l.q}</p>
            <p class="muted" style="margin-top: 8px">典型症状：{l.symptom}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead idx="02" title="四条交付原则" sub="让系统能跑、结果能验、团队接得住。" />
      <div class="grid-2">
        {principles.map((p) => (
          <article class="card">
            <p class="eyebrow">{p.n}</p>
            <h3 style="margin: 8px 0 6px">{p.t}</h3>
            <p>{p.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead idx="03" title="四步合作流程" sub="每步有明确产出，达标再进下一步。" />
      <div class="process-flow" aria-label="诊断、方案、验证、验收四步合作流程">
        {steps.map((s) => (
          <article class="card process-step">
            <span class="tag">{s.n}</span>
            <h4 style="margin-top: 10px">{s.t}</h4>
            <p>{s.d}</p>
          </article>
        ))}
      </div>
      <article class="card acceptance-note">
        <h4>验收不只看演示效果</h4>
        <p>业务侧看指标变化，团队侧看能否独立操作，风险侧看人工审核是否有效。</p>
      </article>
      <div class="btn-row">
        <a class="btn btn-solid" href={base + 'book/'}>预约需求初筛</a>
        <a class="btn" href={base + 'services/'}>查看服务与边界</a>
      </div>
    </div>
  </section>

  <style>
    .process-flow {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 40px;
    }

    .process-step {
      position: relative;
    }

    .process-step:not(:last-child)::after {
      content: "→";
      position: absolute;
      top: 30px;
      right: -31px;
      color: var(--accent-dark);
      font-size: 26px;
      font-weight: 700;
      line-height: 1;
    }

    .acceptance-note {
      margin-top: 24px;
      background: var(--tint);
    }

    @media (max-width: 800px) {
      .process-flow {
        grid-template-columns: 1fr;
        gap: 36px;
      }

      .process-step:not(:last-child)::after {
        content: "↓";
        top: auto;
        right: 50%;
        bottom: -30px;
        transform: translateX(50%);
      }
    }
  </style>
</Base>
